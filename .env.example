# ============================================================
#  JARVIS — Configuración de entorno
#  Copia este archivo a .env y llena tus credenciales reales
#  NUNCA subas el archivo .env a GitHub
# ============================================================

# --- Groq (IA + Transcripción) ---
# Obtén tu key en: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# --- Jarvis Cloud (conexión del Agent al servidor 24/7 en Render) ---
# URL HTTP del Cloud para chat, memoria e historial (ej: https://jarvis-cloud-xxxx.onrender.com)
CLOUD_HTTP_URL=
# URL de WebSocket de tu Jarvis Cloud, ej: wss://jarvis-cloud-xxxx.onrender.com
CLOUD_WS_URL=
# Mismo token que configuraste en Render y usarás en la app móvil
AUTH_TOKEN=

# --- Spotify (Opcional) ---
# Crea una app en: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Este se genera automáticamente al autenticarte con /spotify-auth
SPOTIFY_REFRESH_TOKEN=

# --- Wake Word ---
# Usa openWakeWord (modelo "hey_jarvis"), corre local, no necesita ninguna key.
# Solo asegúrate de correr: pip install -r backend/requirements.txt

# --- Voz / idioma ---
# auto = responde en el idioma detectado; también acepta es o en
TTS_LANGUAGE=auto
TTS_VOICE_ES=es-MX-DaliaNeural
TTS_VOICE_EN=en-US-GuyNeural
